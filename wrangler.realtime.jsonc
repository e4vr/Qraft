{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "qraft-realtime",
  "main": "workers/realtime.ts",
  "compatibility_date": "2026-09-07",
  "workers_dev": false,
  "observability": { "enabled": true },
  "durable_objects": { "bindings": [{ "name": "REALTIME", "class_name": "RealtimeChannel" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RealtimeChannel"] }]
}
