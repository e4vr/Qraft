{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "qraft-realtime",
  "main": "workers/realtime.ts",
  "compatibility_date": "2026-09-09",
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.01,
    "redact_query_string": true
  },
  "durable_objects": { "bindings": [{ "name": "REALTIME", "class_name": "RealtimeChannel" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RealtimeChannel"] }]
}
