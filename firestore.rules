rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function hasProfile() { return signedIn() && exists(/databases/$(database)/documents/profiles/$(request.auth.uid)); }
    function profile() { return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data; }
    function active() { return hasProfile() && profile().status == 'approved' && profile().suspended != true; }
    function rootUid() { return get(/databases/$(database)/documents/system/security).data.superAdminUid; }
    function superAdmin() { return active() && profile().role == 'super_admin' && request.auth.uid == rootUid(); }
    function accessManager() { return superAdmin() || (active() && profile().platformRoles.hasAny(['access_manager'])); }
    function globalReviewer() { return active() && profile().platformRoles.hasAny(['reviewer']); }
    function bank(qbankId) { return get(/databases/$(database)/documents/qbanks/$(qbankId)).data; }
    function membershipExists(qbankId) { return exists(/databases/$(database)/documents/qbankMemberships/$(qbankId + '_' + request.auth.uid)); }
    function membership(qbankId) { return get(/databases/$(database)/documents/qbankMemberships/$(qbankId + '_' + request.auth.uid)).data; }
    function canAccessBank(qbankId) {
      return active() && (superAdmin() || bank(qbankId).visibility == 'public' || bank(qbankId).ownerId == request.auth.uid || membershipExists(qbankId));
    }
    function canReviewBank(qbankId) {
      return active() && (
        bank(qbankId).ownerId == request.auth.uid
        || (membershipExists(qbankId) && membership(qbankId).role == 'reviewer')
        || (bank(qbankId).visibility == 'public' && (superAdmin() || globalReviewer()))
      );
    }
    function identityMatches(data) { return data.updatedById == request.auth.uid && data.updatedByName == profile().displayName; }

    match /system/security {
      allow read: if active();
      allow create: if false;
      allow update: if superAdmin() && request.resource.data.superAdminUid == resource.data.superAdminUid;
      allow delete: if false;
    }

    match /system/questionCounter {
      allow read: if active();
      allow create: if active()
        && request.resource.data.lastActorId == request.auth.uid
        && canReviewBank(request.resource.data.lastQBankId)
        && request.resource.data.nextNumber is int
        && request.resource.data.nextNumber > 218
        && request.resource.data.nextNumber <= 100000;
      allow update: if active()
        && request.resource.data.lastActorId == request.auth.uid
        && canReviewBank(request.resource.data.lastQBankId)
        && request.resource.data.nextNumber is int
        && request.resource.data.nextNumber > resource.data.nextNumber
        && request.resource.data.nextNumber - resource.data.nextNumber <= 200
        && request.resource.data.nextNumber <= 100000;
      allow delete: if false;
    }

    match /questionIds/{questionId} {
      allow read: if active();
      allow create: if active()
        && questionId.matches('^[0-9]{5}$')
        && request.resource.data.questionId == questionId
        && request.resource.data.createdById == request.auth.uid
        && canReviewBank(request.resource.data.qbankId)
        && !exists(/databases/$(database)/documents/questionIds/$(questionId));
      allow update, delete: if false;
    }

    match /profiles/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || accessManager() || superAdmin());
      allow list: if accessManager() || superAdmin();
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.role == 'student'
        && request.resource.data.tier == 'lite'
        && request.resource.data.platformRoles.size() == 0
        && request.resource.data.status == 'pending'
        && exists(/databases/$(database)/documents/universityIds/$(request.resource.data.universityId))
        && getAfter(/databases/$(database)/documents/universityIds/$(request.resource.data.universityId)).data.claimedById == userId;
      allow update: if (superAdmin()
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.universityId == resource.data.universityId
          && (request.resource.data.role != 'super_admin' || userId == rootUid() && resource.data.role == 'super_admin'))
        || (accessManager()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'approvedAt', 'approvedById', 'approvedByName', 'suspended']))
        || (signedIn() && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName']));
      allow delete: if false;
    }

    match /universityIds/{studentId} {
      allow get: if signedIn();
      allow list, create: if superAdmin();
      allow update: if superAdmin()
        || (signedIn() && resource.data.claimedById == null
          && request.resource.data.claimedById == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimedById', 'claimedByName', 'claimedAt']));
      allow delete: if superAdmin() && resource.data.claimedById == null;
    }

    match /adminInvites/{inviteId} {
      allow read, create, update: if superAdmin();
      allow delete: if false;
    }

    match /qbanks/{qbankId} {
      allow read: if active() && (superAdmin() || resource.data.visibility == 'public' || resource.data.ownerId == request.auth.uid || membershipExists(qbankId));
      allow create: if active()
        && (profile().tier == 'pro' || superAdmin())
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.createdById == request.auth.uid
        && request.resource.data.visibility in ['public', 'private'];
      allow update: if active()
        && request.resource.data.ownerId == resource.data.ownerId
        && (resource.data.ownerId == request.auth.uid || (resource.data.visibility == 'public' && superAdmin()));
      allow delete: if active() && resource.data.ownerId == request.auth.uid;
    }

    match /qbankMemberships/{membershipId} {
      allow read: if active() && (request.auth.uid == resource.data.userId || bank(resource.data.qbankId).ownerId == request.auth.uid || superAdmin());
      allow create: if active() && request.resource.data.id == membershipId && (
        (bank(request.resource.data.qbankId).ownerId == request.auth.uid && request.resource.data.role in ['reviewer', 'viewer'])
        || (request.resource.data.userId == request.auth.uid && request.resource.data.role == 'viewer'
          && request.resource.data.viaLink == true
          && get(/databases/$(database)/documents/qbankShareLinks/$(request.resource.data.accessToken)).data.enabled == true
          && get(/databases/$(database)/documents/qbankShareLinks/$(request.resource.data.accessToken)).data.qbankId == request.resource.data.qbankId)
        || (request.resource.data.userId == request.auth.uid && request.resource.data.inviteId is string
          && get(/databases/$(database)/documents/qbankInvitations/$(request.resource.data.inviteId)).data.email == request.auth.token.email
          && get(/databases/$(database)/documents/qbankInvitations/$(request.resource.data.inviteId)).data.qbankId == request.resource.data.qbankId
          && get(/databases/$(database)/documents/qbankInvitations/$(request.resource.data.inviteId)).data.status == 'pending'
          && get(/databases/$(database)/documents/qbankInvitations/$(request.resource.data.inviteId)).data.role == request.resource.data.role)
      );
      allow update, delete: if active() && bank(resource.data.qbankId).ownerId == request.auth.uid;
    }

    match /qbankShareLinks/{token} {
      allow get: if active();
      allow list: if false;
      allow create, update: if active()
        && request.resource.data.id == token
        && getAfter(/databases/$(database)/documents/qbanks/$(request.resource.data.qbankId)).data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid;
      allow delete: if active() && bank(resource.data.qbankId).ownerId == request.auth.uid;
    }

    match /qbankInvitations/{inviteId} {
      allow read: if active() && (resource.data.email == request.auth.token.email || bank(resource.data.qbankId).ownerId == request.auth.uid || superAdmin());
      allow create: if active() && bank(request.resource.data.qbankId).ownerId == request.auth.uid
        && request.resource.data.invitedById == request.auth.uid && request.resource.data.role in ['reviewer', 'viewer'];
      allow update: if active() && (
        bank(resource.data.qbankId).ownerId == request.auth.uid
        || (resource.data.email == request.auth.token.email
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedById', 'acceptedAt']))
      );
      allow delete: if active() && bank(resource.data.qbankId).ownerId == request.auth.uid;
    }

    match /questionProposals/{proposalId} {
      allow read: if active() && (request.auth.uid == resource.data.proposedById || superAdmin() || canReviewBank(resource.data.qbankId));
      allow create: if active() && canAccessBank(request.resource.data.qbankId)
        && request.resource.data.proposedById == request.auth.uid
        && request.resource.data.proposedByName == profile().displayName
        && request.resource.data.status == 'pending'
        && request.resource.data.editKinds.size() > 0
        && request.resource.data.payload.explanation.size() > 0
        && request.resource.data.payload.sourceReference.size() > 0;
      allow update: if canReviewBank(resource.data.qbankId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedById', 'reviewedByName', 'reviewedAt', 'reviewNote']);
      allow delete: if active() && bank(resource.data.qbankId).ownerId == request.auth.uid;
    }

    match /sharedQuestions/{questionId} {
      allow read: if canAccessBank(resource.data.qbankId);
      allow create: if canReviewBank(request.resource.data.qbankId)
        && request.resource.data.questionId.matches('^[0-9]{5}$')
        && (
          (request.resource.data.qbankId == 'smle-gs' && request.resource.data.id.matches('^gs-[0-9]{3}$'))
          || (exists(/databases/$(database)/documents/questionIds/$(request.resource.data.questionId))
            && get(/databases/$(database)/documents/questionIds/$(request.resource.data.questionId)).data.qbankId == request.resource.data.qbankId)
        );
      allow update: if canReviewBank(resource.data.qbankId)
        && request.resource.data.qbankId == resource.data.qbankId
        && (!('questionId' in resource.data) || request.resource.data.questionId == resource.data.questionId);
      allow delete: if active() && bank(resource.data.qbankId).ownerId == request.auth.uid;
    }

    match /answerStats/{statId} {
      allow read: if canAccessBank(resource.data.qbankId);
      allow create: if canAccessBank(request.resource.data.qbankId)
        && request.resource.data.selections.keys().hasOnly([request.auth.uid]);
      allow update: if canAccessBank(resource.data.qbankId)
        && !resource.data.selections.keys().hasAny([request.auth.uid])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['selections'])
        && request.resource.data.selections.diff(resource.data.selections).affectedKeys().hasOnly([request.auth.uid]);
      allow delete: if active() && bank(resource.data.qbankId).ownerId == request.auth.uid;
    }

    match /roleApplications/{applicationId} {
      allow read: if active() && (request.auth.uid == resource.data.userId || superAdmin());
      allow create: if active() && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedRole in ['pro', 'reviewer', 'access_manager'];
      allow update: if superAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt', 'reviewedById', 'reviewedByName']);
      allow delete: if false;
    }

    match /sharedNotes/{noteId} {
      allow read: if canAccessBank(resource.data.qbankId);
      allow create: if canAccessBank(request.resource.data.qbankId) && identityMatches(request.resource.data)
        && request.resource.data.version == 1 && request.resource.data.history.size() == 1;
      allow update: if canAccessBank(resource.data.qbankId) && identityMatches(request.resource.data)
        && request.resource.data.qbankId == resource.data.qbankId
        && request.resource.data.questionId == resource.data.questionId
        && request.resource.data.version == resource.data.version + 1
        && request.resource.data.history.size() == resource.data.history.size() + 1
        && request.resource.data.history[request.resource.data.history.size() - 1].editedById == request.auth.uid
        && request.resource.data.history[request.resource.data.history.size() - 1].editedByName == profile().displayName;
      allow delete: if active() && bank(resource.data.qbankId).ownerId == request.auth.uid;
    }

    match /auditLog/{entryId} {
      allow read: if superAdmin();
      allow create: if active() && request.resource.data.actorId == request.auth.uid
        && request.resource.data.actorName == profile().displayName;
      allow update, delete: if false;
    }

    match /users/{userId}/{document=**} {
      allow read, write: if active() && request.auth.uid == userId;
    }
  }
}
