ROOT_ADMIN_EMAIL=admin@example.com
ROOT_ADMIN_SETUP_TOKEN=replace-with-a-long-random-secret
BACKUP_SIGNING_KEY=replace-with-at-least-32-random-characters
# Optional compatibility fallback only. New deployments should use the ASSETS R2 binding.
IMAGEKIT_PRIVATE_KEY=private_your_imagekit_private_key
R2_PUBLIC_URL=https://assets.example.com
R2_BILLING_CYCLE_DAY=7
R2_STORAGE_CAP_BYTES=3221225472
R2_CLASS_A_MONTHLY_CAP=800000
R2_CLASS_B_MONTHLY_CAP=8000000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Monitoring: secrets are server-only; never use a NEXT_PUBLIC_ prefix.
CLOUDFLARE_ANALYTICS_TOKEN=replace-with-account-analytics-read-only-token
TELEMETRY_SALT=replace-with-at-least-32-random-characters
CLOUDFLARE_ACCOUNT_ID=your_32_character_account_id
QRAFT_TELEMETRY_ENABLED=false
