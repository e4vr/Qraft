{
  "name": "medguard-smle-qbank",
  "version": "1.2.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "source-map-js": "1.2.2",
    "shadcn": {
      "undici": "7.30.0"
    }
  },
  "scripts": {
    "postinstall": "node scripts/harden-braces.mjs",
    "prebuild": "node scripts/harden-braces.mjs",
    "pretest": "node scripts/harden-braces.mjs",
    "dev": "vinext dev",
    "build": "vinext build",
    "test": "node --test tests/*.test.mjs",
    "test:saas": "node --test tests/saas-reliability.test.mjs tests/platform-api.test.mjs",
    "typecheck": "tsc --noEmit",
    "start": "wrangler dev --config dist/server/wrangler.json --config dist/qraft_realtime/wrangler.json",
    "build:staging": "node scripts/build-staging.mjs",
    "deploy:staging": "node scripts/deploy-staging.mjs",
    "deploy:production": "node scripts/deploy-production.mjs",
    "deploy:production:realtime": "node scripts/deploy-production.mjs realtime",
    "deploy:production:app": "node scripts/deploy-production.mjs app",
    "lint": "oxlint",
    "format": "oxfmt",
    "db:generate": "node scripts/database-schema.mjs generate",
    "db:check": "node scripts/database-schema.mjs check",
    "db:migrate:local": "wrangler d1 migrations apply qraft-qbank --local",
    "cloudflare:check": "node scripts/cloudflare-check.mjs",
    "db:migrate:staging": "node scripts/staging-database.mjs migrate",
    "db:seed:staging": "node scripts/seed-staging.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.3",
    "jsonrepair": "^3.15.0",
    "lucide-react": "1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "^19.2.8",
    "shadcn": "4.18.0",
    "sql.js": "^1.14.2",
    "tailwind-merge": "3.6.0",
    "ts-fsrs": "^5.4.2",
    "tw-animate-css": "1.4.0",
    "vinext": "^1.0.0-beta.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.7",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "^0.5.34",
    "drizzle-kit": "^0.31.10",
    "fake-indexeddb": "^6.2.5",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "sharp": "0.35.4",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "^8.2.2",
    "wrangler": "^4.135.0"
  },
  "type": "module"
}
