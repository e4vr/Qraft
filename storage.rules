rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function approved() {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/profiles/$(request.auth.uid)).data.status == 'approved'
        && firestore.get(/databases/(default)/documents/profiles/$(request.auth.uid)).data.suspended != true;
    }
    function canAccess(qbankId) {
      return approved() && (
        firestore.get(/databases/(default)/documents/profiles/$(request.auth.uid)).data.role == 'super_admin'
        || firestore.get(/databases/(default)/documents/qbanks/$(qbankId)).data.visibility == 'public'
        || firestore.get(/databases/(default)/documents/qbanks/$(qbankId)).data.ownerId == request.auth.uid
        || firestore.exists(/databases/(default)/documents/qbankMemberships/$(qbankId + '_' + request.auth.uid))
      );
    }

    match /qbanks/{qbankId}/notes/{questionId}/{userId}/{fileName} {
      allow read: if canAccess(qbankId);
      allow create, update: if canAccess(qbankId)
        && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth.uid == userId
        || firestore.get(/databases/(default)/documents/qbanks/$(qbankId)).data.ownerId == request.auth.uid;
    }
  }
}
